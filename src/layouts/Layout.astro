---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  canonical?: boolean;
  article?: { date: Date; tags: string[] };
}
const { title, description = site.description, active = '', noindex = false, canonical: showCanonical = true, article } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — 学习、探索与创造`;
const canonical = showCanonical ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = new URL(url('social-card.png'), Astro.site);
const navigation = [
  { label: '首页', path: '', key: 'home' },
  { label: '实验记录', path: 'experiments/', key: 'experiments' },
  { label: '学习记录', path: 'notes/', key: 'notes' },
  { label: '项目展示', path: 'projects/', key: 'projects' },
  { label: '关于我', path: 'about/', key: 'about' },
];
const articleSchema = article && canonical ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.date.toISOString(),
  author: { '@type': 'Person', name: site.author },
  mainEntityOfPage: canonical.href,
  url: canonical.href,
  image: socialImage.href,
  keywords: article.tags.join(', '),
  inLanguage: 'zh-CN',
} : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7453de" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="lulu's blog：把想法接上线，让知识慢慢发光。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="lulu's blog：学习记录与项目手记" />
    {article && <>
      <meta name="author" content={site.author} />
      <meta property="article:published_time" content={article.date.toISOString()} />
      {article.tags.map(tag => <meta property="article:tag" content={tag} />)}
    </>}
    {articleSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema).replaceAll('<', '\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('lulu-theme');
        document.documentElement.dataset.theme = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body class:list={{ 'home-page': active === 'home' }}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href={url()} aria-label="lulu's blog 首页"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>lulu<span class="brand-apostrophe">’</span>s blog<span class="brand-dot">.</span></span></a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map(item => <a href={url(item.path)} class:list={['nav-link', { active: active === item.key }]} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="icon-button search-trigger" aria-label="搜索实验、笔记和项目" title="搜索（Ctrl / ⌘ + K）"><Icon name="search" /><kbd class="search-shortcut">Ctrl K</kbd></button>
          <button id="theme-toggle" class="icon-button" aria-label="切换深色模式"><Icon name="sun" class="theme-sun" /><Icon name="moon" class="theme-moon" /></button>
          <button id="menu-toggle" class="icon-button mobile-menu-button" aria-label="展开导航" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav container" aria-label="移动端导航" hidden>
        {navigation.map(item => <a href={url(item.path)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top"><a class="footer-brand" href={url()}>lulu's blog<span>✳</span></a><p>保持好奇，慢慢积累。<br /><span>Made of little experiments & big questions.</span></p><a class="rss-link" href={url('rss.xml')}><Icon name="rss" size={17} /> RSS 订阅</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} lulu · 学习记录与项目手记</span><span class="footer-note">记录每一次「原来如此」。<span class="tiny-dot"></span></span></div>
    </footer>
    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title" data-index={url('search-index.json')}>
      <div class="search-dialog-header"><h2 id="search-title">寻找一个想法</h2><button id="search-close" class="icon-button" aria-label="关闭搜索"><Icon name="close" /></button></div>
      <label class="search-input-wrap"><Icon name="search" /><span class="sr-only">搜索标题、标签或简介</span><input id="search-input" type="search" placeholder="搜索实验、笔记、项目…" autocomplete="off" aria-controls="search-results" aria-describedby="search-help" /></label>
      <p id="search-status" class="search-status" role="status">输入关键词，开始探索。</p>
      <div id="search-results" class="search-results" aria-label="搜索结果"></div>
      <div id="search-help" class="search-dialog-footer"><span>标题、简介和标签 · ↑ ↓ 选择 · Enter 打开</span><span><kbd>ESC</kbd> 关闭</span></div>
    </dialog>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .search-dialog :global(.search-result.is-selected) { background: var(--purple-soft); }
  @media (max-width: 420px) {
    .search-dialog-footer { gap: 10px; align-items: center; font-size: 9px; }
    .search-dialog-footer > span:last-child { white-space: nowrap; }
  }
</style>
