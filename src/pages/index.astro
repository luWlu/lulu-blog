---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { allNotes, allProjects, allExperiments, url } from '../lib/site';
const notes = await allNotes();
const projects = await allProjects();
const experiments = await allExperiments();
const sampleMode = (notes.length > 0 || projects.length > 0 || experiments.length > 0) && !notes.some(note => !note.data.sample) && !projects.some(project => !project.data.sample) && !experiments.some(experiment => !experiment.data.sample);
---
<Layout active="home">
  <div class="container home-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="live-dot"></span> HELLO, I'M LULU <span class="eyebrow-line"></span></div>
        <h1 id="hero-title">把想法<span class="hero-highlight">接上线</span>，<br />让知识慢慢<span class="word-glow">发光<svg viewBox="0 0 176 12" aria-hidden="true"><path d="M3 9C48 0 116 0 172 7" /></svg></span>。</h1>
        <p class="hero-description">一名硬件电子方向研究生的数字小角落。<br />在这里记录学习的轨迹，也把脑海里的想法做出来。</p>
        <div class="hero-buttons"><a class="button button-primary" href={url('experiments/')}><Icon name="chip" size={18} /> 看 Zynq 实验记录</a><a class="button button-secondary" href={url('notes/')}>翻开学习记录 <Icon name="right" size={18} /></a></div>
        <div class="hero-interests"><span>正在探索</span><span class="interest-dot"></span><span>硬件电子</span><span class="interest-dot"></span><span>电路与系统</span><span class="interest-dot"></span><span>更多可能</span></div>
      </div>
      <div class="hero-art" aria-label="把想法转化为实验、再记录成笔记的电路主题插画" role="img">
        <div class="art-floating-label"><span>✳</span> STAY CURIOUS.</div>
        <div class="circuit-window">
          <div class="circuit-window-header"><span class="window-dots"><i></i><i></i><i></i></span><span>lulu / idea-lab</span><span>↗</span></div>
          <div class="circuit-window-body"><div class="circuit-title">a little spark,<br />a new possibility<span>_</span></div>
            <svg class="hero-circuit" viewBox="0 0 360 178" fill="none" aria-hidden="true">
              <path d="M35 90h62v-47h64m38 0h65v47h61M97 90v55h64m38 0h65V90M180 67v46" stroke="#c9f275" stroke-width="2" stroke-linecap="round" />
              <path d="M180 14v17m0 128v12M16 90h10m308 0h10" stroke="#c9f275" stroke-width="2" />
              <circle cx="35" cy="90" r="7" fill="#c9f275" /><circle cx="325" cy="90" r="7" fill="#ffb28a" />
              <rect x="141" y="51" width="78" height="78" rx="13" fill="#c9f275" />
              <rect x="155" y="65" width="50" height="50" rx="6" stroke="#463178" stroke-width="2" />
              <path d="m167 91 9 9 18-20" stroke="#463178" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M160 43v8m13-8v8m14-8v8m13-8v8M160 129v8m13-8v8m14-8v8m13-8v8M133 70h8m-8 13h8m-8 14h8m-8 13h8m78-40h8m-8 13h8m-8 14h8m-8 13h8" stroke="#c9f275" stroke-width="3" />
              <circle cx="97" cy="90" r="4" fill="#c9f275" /><circle cx="264" cy="90" r="4" fill="#c9f275" />
              <text x="15" y="122" fill="#e0d3ff" font-size="11" font-family="monospace">IDEA IN</text><text x="285" y="122" fill="#e0d3ff" font-size="11" font-family="monospace">NOTE OUT</text>
            </svg>
            <div class="circuit-stages"><span><i>01</i> 想一想</span><span>→</span><span><i>02</i> 试一试</span><span>→</span><span><i>03</i> 记下来</span></div>
          </div>
        </div>
        <div class="art-sticker"><Icon name="sparkle" size={36} /></div>
        <div class="art-note"><span class="note-pin"></span><span>小小的进步，<br />也值得被记录。</span><svg viewBox="0 0 64 16" aria-hidden="true"><path d="M2 12c12-20 17 8 29-4S48 18 62 3" /></svg></div>
        <div class="art-coordinate">FIG. 01 — MY LITTLE CORNER OF THE INTERNET</div>
      </div>
    </section>
    <div class="interest-strip"><span><Icon name="chip" size={19} /> 从电路到代码</span><span class="strip-symbol">✳</span><span><Icon name="book" size={19} /> 从问题到理解</span><span class="strip-symbol">✳</span><span><Icon name="folder" size={19} /> 从想法到作品</span><span class="strip-end">ALWAYS IN PROGRESS ↗</span></div>
    <section class="home-section" aria-labelledby="notes-heading">
      <div class="section-heading"><div><div class="section-kicker">01 / LEARNING IN PUBLIC</div><h2 id="notes-heading">最近的学习记录<span class="heading-dot purple"></span></h2><p>给知识留个坐标，也给未来的自己一点线索。</p></div><a class="text-link" href={url('notes/')}>全部记录 <Icon name="right" size={17} /></a></div>
      {sampleMode && <div class="sample-notice"><span class="tiny-dot"></span> 这个小站刚刚开始。下方是示例内容，真实笔记与项目正在等待上传。</div>}
      {notes.length ? <div class="notes-grid">{notes.slice(0, 3).map((note, index) => <NoteCard note={note} index={index} />)}</div> : <div class="empty-state"><Icon name="book" size={30} /><h3>第一篇笔记，正在路上。</h3><p>学习是一点一点积累的，记录也一样。</p></div>}
    </section>
    <section class="home-section" aria-labelledby="experiments-heading">
      <div class="section-heading"><div><div class="section-kicker">02 / THE ZYNQ LAB</div><h2 id="experiments-heading">Zynq 实验记录<span class="heading-dot purple"></span></h2><p>从点灯到模拟量采集与输出，每一步都留下可复现的记录。</p></div><a class="text-link" href={url('experiments/')}>全部实验 <Icon name="right" size={17} /></a></div>
      {experiments.length ? <div class="experiments-grid">{experiments.slice(0, 3).map(experiment => <ExperimentCard experiment={experiment} />)}</div> : <div class="empty-state"><Icon name="chip" size={30} /><h3>实验记录正在整理。</h3><p>整理好之后会出现在这里。</p></div>}
    </section>
    <section class="home-section projects-section" aria-labelledby="projects-heading">
      <div class="section-heading"><div><div class="section-kicker">03 / IDEAS INTO REALITY</div><h2 id="projects-heading">动手做点什么<span class="heading-dot orange"></span></h2><p>让灵感落在面包板上，也落在每一次尝试里。</p></div><a class="text-link" href={url('projects/')}>所有项目 <Icon name="right" size={17} /></a></div>
      {projects.length ? <div class="projects-grid">{projects.slice(0, 2).map(project => <ProjectCard project={project} />)}</div> : <div class="empty-state"><Icon name="folder" size={30} /><h3>下一次实验，从这里开始。</h3><p>项目完成后，会把思路、过程和结果放在这里。</p></div>}
    </section>
    <section class="about-banner"><div class="about-banner-mark" aria-hidden="true">l<span>✳</span></div><div><span class="section-kicker">A LITTLE ABOUT ME</span><h2>你好，我是 lulu。</h2><p>硬件电子方向研究生。在探索中学习，在记录中成长。</p></div><a class="button button-secondary" href={url('about/')}>认识一下 <Icon name="arrow" size={17} /></a></section>
  </div>
</Layout>