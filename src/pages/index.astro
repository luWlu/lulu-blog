---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import ProjectArt from '../components/ProjectArt.astro';
import HomeMotion from '../components/HomeMotion.astro';
import '../styles/home.css';
import { allNotes, allProjects, allExperiments, url, dateLabel, readingTime, stepLabel } from '../lib/site';

const [notes, projects, experiments] = await Promise.all([allNotes(), allProjects(), allExperiments()]);
const recentExperiments = [...experiments].sort((a, b) => Number(a.data.sample) - Number(b.data.sample) || b.data.date.getTime() - a.data.date.getTime() || b.data.order - a.data.order);
const [featuredExperiment, ...otherExperiments] = recentExperiments;
const publishedCount = (entries: typeof notes | typeof projects | typeof experiments) => entries.filter(entry => !entry.data.sample).length;
const destinations = [
  { id: 'lab', number: '01', icon: 'chip' as const, title: '实验工作台', subtitle: '连接、调试，再多问一个为什么', count: publishedCount(experiments), unit: '篇实验', tone: 'purple' },
  { id: 'journal', number: '02', icon: 'book' as const, title: '学习笔记本', subtitle: '把零散知识，连成自己的地图', count: publishedCount(notes), unit: '篇笔记', tone: 'lime' },
  { id: 'work', number: '03', icon: 'folder' as const, title: '想法陈列架', subtitle: '给每一个小想法，留一点空间', count: publishedCount(projects), unit: '个项目', tone: 'orange' },
];
---
<Layout active="home">
  <div class="container home-content" data-home>
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <div class="hero-copy hero-journal" data-reveal>
        <div class="hero-journal-label">
          <span>个人手记</span>
          <span class="journal-label-rule" aria-hidden="true"></span>
          <span>HARDWARE / LEARNING</span>
        </div>
        <h1 id="hero-title" class="journal-masthead">
          <span class="hero-signature">lulu<span class="signature-dot">.</span><svg class="signature-trace" viewBox="0 0 90 48" fill="none" aria-hidden="true"><path d="M2 25h19l8-17 12 33 10-23 8 7h29"/><circle cx="88" cy="25" r="2"/></svg></span>
          <span class="hero-title-caption">硬件研究与学习手记</span>
        </h1>
        <p class="hero-description">记录 Zynq 实验、电路与系统的学习过程。遇到的问题、试过的方法、想明白的原理，都放在这里。</p>
        <dl class="hero-byline">
          <div><dt>记录者</dt><dd>硬件电子方向研究生</dd></div>
          <div><dt>记录方式</dt><dd>阅读、动手、验证、复盘</dd></div>
        </dl>
        <div class="hero-actions">
          <a class="hero-lab-link" href={url('experiments/')}>
            <span class="hero-action-copy"><span>01 / EXPERIMENTS</span><strong>走进实验工作台</strong></span>
            <span class="hero-action-arrow"><Icon name="right" size={19} /></span>
          </a>
          <a class="hero-notes-link" href={url('notes/')}>查阅学习笔记 <Icon name="arrow" size={15} /></a>
        </div>
      </div>
      <div class="hero-art" data-hero-art aria-label="把想法转化为实验、再记录成笔记的电路主题插画" role="img">
        <div class="art-floating-label" data-parallax="0.035"><span>✳</span> STAY CURIOUS.</div>
        <div class="circuit-window" data-parallax="-0.045">
          <div class="circuit-window-header"><span class="window-dots"><i></i><i></i><i></i></span><span>lulu / idea-lab</span><span>↗</span></div>
          <div class="circuit-window-body"><div class="circuit-title">a little spark,<br />a new possibility<span>_</span></div>
            <svg class="hero-circuit" viewBox="0 0 360 178" fill="none" aria-hidden="true">
              <path d="M35 90h62v-47h64m38 0h65v47h61M97 90v55h64m38 0h65V90M180 67v46" stroke="#c9f275" stroke-width="2" stroke-linecap="round" />
              <path d="M180 14v17m0 128v12M16 90h10m308 0h10" stroke="#c9f275" stroke-width="2" />
              <circle cx="35" cy="90" r="7" fill="#c9f275" /><circle cx="325" cy="90" r="7" fill="#ffb28a" />
              <rect x="141" y="51" width="78" height="78" rx="13" fill="#c9f275" />
              <rect x="155" y="65" width="50" height="50" rx="6" stroke="#463178" stroke-width="2" />
              <path d="m167 91 9 9 18-20" stroke="#463178" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M160 43v8m13-8v8m14-8v8m13-8v8M160 129v8m13-8v8m14-8v8m13-8v8M133 70h8m-8 13h8m-8 14h8m-8 13h8m78-40h8m-8 13h8m-8 14h8m-8 13h8" stroke="#c9f275" stroke-width="3" />
              <circle cx="97" cy="90" r="4" fill="#c9f275" /><circle cx="264" cy="90" r="4" fill="#c9f275" />
              <text x="15" y="122" fill="#e0d3ff" font-size="11" font-family="monospace">IDEA IN</text><text x="285" y="122" fill="#e0d3ff" font-size="11" font-family="monospace">NOTE OUT</text>
            </svg>
            <div class="circuit-stages"><span><i>01</i> 想一想</span><span>→</span><span><i>02</i> 试一试</span><span>→</span><span><i>03</i> 记下来</span></div>
          </div>
        </div>
        <div class="art-sticker" data-parallax="0.09"><Icon name="sparkle" size={36} /></div>
        <div class="art-note" data-parallax="0.065"><span class="note-pin"></span><span>小小的进步，<br />也值得被记录。</span><svg viewBox="0 0 64 16" aria-hidden="true"><path d="M2 12c12-20 17 8 29-4S48 18 62 3" /></svg></div>
        <div class="art-coordinate">FIG. 01 — MY LITTLE CORNER OF THE INTERNET</div>
      </div>
      <div class="hero-bottom"><span>LEARN. BUILD. DOCUMENT.</span><a href="#explore">往下翻，发现更多 <span aria-hidden="true">↓</span></a><span class="hero-bottom-note">一点好奇，一点积累。</span></div>
    </section>

    <nav id="explore" class="explore-grid" aria-label="探索首页栏目">
      {destinations.map((item, index) => <a class:list={['explore-card', `explore-${item.tone}`]} href={`#${item.id}`} data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <div class="explore-card-top"><span class="explore-icon"><Icon name={item.icon} size={22} /></span><span class="explore-number">{item.number} /</span><Icon name="arrow" size={19} class="explore-arrow" /></div>
        <h2>{item.title}</h2><p>{item.subtitle}</p><span class="explore-count">{item.count ? `${String(item.count).padStart(2, '0')} ${item.unit}` : '正在慢慢积累'}<span aria-hidden="true">↗</span></span>
      </a>)}
    </nav>

    <section id="lab" class="home-section lab-section" aria-labelledby="experiments-heading">
      <div class="section-heading" data-reveal><div><div class="section-kicker">01 / THE ZYNQ LAB</div><h2 id="experiments-heading">在实验里，寻找答案<span class="heading-dot purple"></span></h2></div><a class="text-link" href={url('experiments/')}>全部实验 <Icon name="right" size={17} /></a></div>
      <div class="lab-layout">
        <aside class="lab-intro" data-reveal>
          <div class="lab-intro-top"><span class="live-dot"></span><span>MY HARDWARE WORKBENCH</span></div>
          <h3>从一颗 LED，<br />到一个完整的系统。</h3>
          <p>从点灯到模拟量采集与输出，把每一步的原理、接线、调试与发现，整理成可复现的记录。</p>
          <div class="lab-signal" aria-hidden="true"><svg viewBox="0 0 260 74" fill="none"><path class="signal-grid" d="M0 18h260M0 37h260M0 56h260M32 0v74M65 0v74M98 0v74M131 0v74M164 0v74M197 0v74M230 0v74"/><path class="signal-wave" d="M0 53h30V21h39v32h40V21h39v32h39V21h39v32h34"/><circle cx="148" cy="21" r="4"/></svg><span>SMALL STEPS. REAL SIGNALS.</span></div>
          <div class="lab-intro-bottom"><span>{String(publishedCount(experiments)).padStart(2, '0')} 篇实验记录</span><a href={url('experiments/')}>查看学习路径 <Icon name="right" size={15} /></a></div>
        </aside>
        <div class="lab-records">
          {featuredExperiment ? <a class="featured-experiment" href={url(`experiments/${featuredExperiment.id}/`)} data-reveal>
            <div class:list={['featured-visual', `accent-${featuredExperiment.data.accent}`]}><ProjectArt diagram={featuredExperiment.data.diagram} /><span>{stepLabel(featuredExperiment.data.order)}</span></div>
            <div class="featured-copy"><div class="featured-top"><span class="featured-label">{featuredExperiment.data.sample ? '示例实验' : '最近更新'}</span><span>{featuredExperiment.data.stage} · {featuredExperiment.data.status}</span><Icon name="arrow" size={20} /></div><h3>{featuredExperiment.data.title}</h3><p>{featuredExperiment.data.description}</p><div class="featured-bottom"><time datetime={featuredExperiment.data.date.toISOString()}>{dateLabel(featuredExperiment.data.date)}</time><span>{readingTime(featuredExperiment.body)} 分钟阅读</span></div></div>
          </a> : <div class="empty-state"><Icon name="chip" size={30} /><h3>实验记录正在整理。</h3><p>整理好之后，会出现在这里。</p></div>}
          {otherExperiments.length > 0 && <div class="lab-secondary">{otherExperiments.slice(0, 2).map((experiment, index) => <div class="card-reveal" data-reveal style={`--reveal-delay: ${index * 70}ms`}><ExperimentCard experiment={experiment} /></div>)}</div>}
        </div>
      </div>
    </section>

    <section id="journal" class="home-section journal-section" aria-labelledby="notes-heading">
      <div class="section-heading" data-reveal><div><div class="section-kicker">02 / LEARNING IN PUBLIC</div><h2 id="notes-heading">给知识，留一个坐标<span class="heading-dot purple"></span></h2><p>写下每一次「原来如此」，也给未来的自己一点线索。</p></div><a class="text-link" href={url('notes/')}>全部记录 <Icon name="right" size={17} /></a></div>
      {notes.some(note => note.data.sample) && <div class="sample-notice" data-reveal><span class="tiny-dot"></span> 标有「示例内容」的笔记用于展示版式，尚不代表真实学习记录。</div>}
      {notes.length ? <div class="journal-layout">{notes.slice(0, 3).map((note, index) => <div class:list={['journal-entry', { 'journal-featured': index === 0 }]} data-reveal style={`--reveal-delay: ${index * 70}ms`}><NoteCard note={note} index={index}>{index === 0 && <div class="journal-cover" aria-hidden="true"><span>FIELD NOTES / 01</span><Icon name="book" size={60} /><span class="journal-cover-spark">✳</span><span>A NOTE TO MY FUTURE SELF.</span></div>}</NoteCard></div>)}</div> : <div class="empty-state"><Icon name="book" size={30} /><h3>第一篇笔记，正在路上。</h3><p>学习是一点一点积累的，记录也一样。</p></div>}
    </section>

    <section id="work" class="home-section projects-section" aria-labelledby="projects-heading">
      <div class="section-heading" data-reveal><div><div class="section-kicker">03 / IDEAS INTO REALITY</div><h2 id="projects-heading">动手做点什么<span class="heading-dot orange"></span></h2><p>让灵感落在面包板上，也落在每一次尝试里。</p></div><a class="text-link" href={url('projects/')}>所有项目 <Icon name="right" size={17} /></a></div>
      {projects.some(project => project.data.sample) && <div class="sample-notice" data-reveal><span class="tiny-dot"></span> 标有「示例项目」的内容用于展示版式，尚不代表已开展的个人项目。</div>}
      {projects.length ? <div class="projects-grid">{projects.slice(0, 2).map((project, index) => <div class="card-reveal" data-reveal style={`--reveal-delay: ${index * 70}ms`}><ProjectCard project={project} /></div>)}</div> : <div class="empty-state"><Icon name="folder" size={30} /><h3>下一次实验，从这里开始。</h3><p>项目完成后，会把思路、过程和结果放在这里。</p></div>}
    </section>

    <section class="about-banner" aria-labelledby="about-heading" data-reveal><div class="about-banner-mark" aria-hidden="true">l<span>✳</span></div><div class="about-banner-copy"><span class="section-kicker">THE PERSON BEHIND THE NOTES</span><h2 id="about-heading">你好，我是 lulu。<br /><span>一直好奇，慢慢成长。</span></h2><p>硬件电子方向研究生。这个小站，是我的笔记本，也是想法的试验场。</p></div><a class="button button-secondary" href={url('about/')}>认识一下 <Icon name="arrow" size={17} /></a><span class="about-decoration" aria-hidden="true">✳</span></section>
  </div>
  <HomeMotion />
</Layout>
