---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/site';
---

<Layout title="关于我" active="about">
  <div class="container about-page">
    <header class="page-heading">
      <div class="section-kicker">THE PERSON BEHIND THE NOTES</div>
      <h1>你好，我是 lulu<span class="heading-spark">✳</span></h1>
      <p>硬件电子方向研究生，也是这个小角落的记录者。</p>
    </header>

    <div class="about-grid">
      <div class="profile-card">
        <div class="profile-avatar" aria-hidden="true">l<span>✳</span></div>
        <h2>lulu</h2>
        <p>硬件电子方向研究生</p>
        <div class="profile-separator"></div>
        <span class="profile-status">
          <span class="live-dot"></span> 保持好奇，持续学习
        </span>
        <div class="profile-tags">
          <span>硬件电子</span>
          <span>学习记录</span>
          <span>项目实践</span>
        </div>
      </div>

      <div class="about-copy">
        <span class="section-kicker">WHY THIS BLOG?</span>
        <h2>给学习留下一点痕迹。</h2>
        <p>
          这个博客是我的学习记录与项目手记。我想把零散的理解整理起来，把尝试的过程保存下来，也给未来的自己留下一份可以回看的笔记。
        </p>
        <p>
          实验记录从 Zynq 点灯出发，逐步整理数字接口、波形测量和 AD/DA 的实践过程；学习记录留给知识梳理与阅读心得；项目展示则用来记录从想法到实现的设计、验证与改进。
        </p>
        <div class="about-quote">
          <span>“</span>
          <p>不必等到完全理解，<br />才开始记录。</p>
        </div>
        <a class="text-link" href={url('experiments/')}>
          从实验记录开始 <Icon name="right" size={18} />
        </a>
      </div>
    </div>

    <section class="about-topics" aria-labelledby="about-topics-heading">
      <div class="section-heading">
        <div>
          <div class="section-kicker">WHAT YOU'LL FIND HERE</div>
          <h2 id="about-topics-heading">这个小站里有什么</h2>
        </div>
      </div>
      <div class="about-topic-grid">
        <a href={url('experiments/')}>
          <Icon name="chip" size={25} />
          <h3>实验记录</h3>
          <p>从 EMIO 点灯到 AD/DA，记录 Zynq 实验的接线、原理与调试过程。</p>
          <span>查看实验学习路径 <Icon name="right" size={16} /></span>
        </a>
        <a href={url('notes/')}>
          <Icon name="book" size={25} />
          <h3>学习记录</h3>
          <p>整理知识，留下思考，让每一个问题都有迹可循。</p>
          <span>打开笔记本 <Icon name="right" size={16} /></span>
        </a>
        <a href={url('projects/')}>
          <Icon name="folder" size={25} />
          <h3>项目展示</h3>
          <p>给想法留一个位置，整理设计思路、验证过程与后续改进。</p>
          <span>走进小工坊 <Icon name="right" size={16} /></span>
        </a>
      </div>
    </section>
  </div>
</Layout>
