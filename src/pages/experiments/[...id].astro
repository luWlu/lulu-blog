---
import { render } from 'astro:content';
import { allExperiments, url, stepLabel } from '../../lib/site';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ExperimentMeta from '../../components/ExperimentMeta.astro';
import ProjectArt from '../../components/ProjectArt.astro';
export async function getStaticPaths() {
  const experiments = await allExperiments();
  return experiments.map((experiment, index) => ({
    params: { id: experiment.id },
    props: { experiment, prev: experiments[index - 1] ?? null, next: experiments[index + 1] ?? null },
  }));
}
const { experiment, prev, next } = Astro.props;
const { Content, headings } = await render(experiment);
---
<ArticleLayout {...experiment.data} kind="experiments" headings={headings} body={experiment.body} category={`${stepLabel(experiment.data.order)} · ${experiment.data.stage}`}>
  <div class:list={['article-project-art', `accent-${experiment.data.accent}`]}><ProjectArt diagram={experiment.data.diagram} /></div>
  <ExperimentMeta stage={experiment.data.stage} status={experiment.data.status} board={experiment.data.board} tools={experiment.data.tools} date={experiment.data.date} order={experiment.data.order} />
  <Content />
  {(prev || next) && <nav class="experiment-nav" aria-label="实验顺序导航">
    {prev ? <a class="experiment-nav-prev" href={url(`experiments/${prev.id}/`)}><span>← 上一个实验</span><strong>{prev.data.title}</strong></a> : <span />}
    {next ? <a class="experiment-nav-next" href={url(`experiments/${next.id}/`)}><span>下一个实验 →</span><strong>{next.data.title}</strong></a> : <span />}
  </nav>}
</ArticleLayout>
