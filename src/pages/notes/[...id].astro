---
import { render } from 'astro:content';
import { allNotes } from '../../lib/site';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Cover from '../../components/Cover.astro';
export async function getStaticPaths() { return (await allNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content, headings } = await render(note);
---
<ArticleLayout {...note.data} kind="notes" headings={headings} body={note.body}>{note.data.cover && <div class="article-project-art" style={`view-transition-name: cover-${note.id}`}><Cover name={note.data.cover} /></div>}<Content /></ArticleLayout>