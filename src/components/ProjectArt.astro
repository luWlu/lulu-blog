---
interface Props { diagram?: 'wave' | 'board' | 'circuit'; }
const { diagram = 'board' } = Astro.props;
const gridId = `grid-${diagram}-${crypto.randomUUID()}`;
---
<div class:list={['project-art', `art-${diagram}`]} aria-hidden="true">
  <svg viewBox="0 0 520 200" fill="none">
    <defs><pattern id={gridId} width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".13" /></pattern></defs>
    <rect width="520" height="200" fill={`url(#${gridId})`} />
    {diagram === 'wave' ? <>
      <rect x="128" y="30" width="264" height="143" rx="12" fill="currentColor" fill-opacity=".06" stroke="currentColor" stroke-opacity=".18" />
      <path d="M145 52h230M152 138V63h216M152 102h216M205 63v75M260 63v75M315 63v75" stroke="currentColor" opacity=".18" />
      <path d="M268 60v82" stroke="currentColor" stroke-dasharray="3 5" opacity=".45" />
      <path d="M152 120h31V77h43v43h42V77h43v43h43V77h14" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="183" cy="120" r="3.5" fill="currentColor" />
      <circle cx="311" cy="120" r="3.5" fill="currentColor" />
      <circle cx="268" cy="77" r="7" fill="var(--art-highlight, var(--orange))" />
      <circle cx="268" cy="77" r="2" fill="var(--art-highlight-ink, var(--text))" />
      <path d="M149 154h30m6 0h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".4" />
      <circle cx="369" cy="154" r="4" fill="var(--art-highlight, var(--orange))" /><circle cx="354" cy="154" r="4" fill="currentColor" opacity=".4" />
      <text x="90" y="42" fill="currentColor" font-size="12" font-family="var(--mono, monospace)" opacity=".75">01 / SIGNAL</text>
      <text x="404" y="159" fill="currentColor" font-size="12" font-family="var(--mono, monospace)" opacity=".75">0 → 1</text>
    </> : diagram === 'circuit' ? <>
      <path d="M100 100h75m170 0h75M175 100V60h85v80h85v-40M175 100v50h85V60h85v40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity=".8" />
      <circle cx="100" cy="100" r="14" stroke="currentColor" opacity=".25" />
      <circle cx="100" cy="100" r="7" fill="currentColor" />
      <circle cx="420" cy="100" r="14" stroke="currentColor" opacity=".25" />
      <circle cx="420" cy="100" r="7" fill="currentColor" />
      <circle cx="175" cy="100" r="4" fill="currentColor" />
      <circle cx="345" cy="100" r="4" fill="currentColor" />
      <circle cx="260" cy="60" r="5" fill="var(--art-highlight, var(--orange))" />
      <rect x="228" y="76" width="64" height="48" rx="7" fill="var(--art-highlight, var(--orange))" />
      <rect x="236" y="84" width="48" height="32" rx="3" stroke="var(--art-highlight-ink, var(--text))" stroke-opacity=".3" />
      <path d="M248 100h24m-12-12v24" stroke="var(--art-highlight-ink, var(--text))" stroke-width="2.5" stroke-linecap="round" />
      <text x="260" y="182" text-anchor="middle" fill="currentColor" font-size="12" font-family="var(--mono, monospace)" opacity=".8">A SMALL CIRCUIT, A NEW IDEA.</text>
    </> : <>
      <rect x="158" y="27" width="208" height="147" rx="15" fill="currentColor" fill-opacity=".06" stroke="currentColor" stroke-width="1.5" stroke-opacity=".25" />
      <path d="M211 93h-18V48h46v6M310 108h20v47h-31" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
      <path d="M239 65V54m15 11V54m15 11V54m15 11V54M239 135v11m15-11v11m15-11v11m15-11v11M222 78h-11m11 15h-11m11 15h-11m11 15h-11M299 78h11m-11 15h11m-11 15h11m-11 15h11" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <rect x="222" y="65" width="77" height="70" rx="8" fill="currentColor" fill-opacity=".8" />
      <rect x="247" y="89" width="27" height="23" rx="3" fill="var(--art-highlight, var(--orange))" />
      <path d="M254 100h13" stroke="var(--art-highlight-ink, var(--text))" stroke-width="2" stroke-linecap="round" />
      <circle cx="231" cy="74" r="2" fill="var(--art-highlight, var(--orange))" />
      <g stroke="currentColor" stroke-opacity=".35">
        <circle cx="177" cy="45" r="5" /><circle cx="345" cy="45" r="5" />
        <circle cx="177" cy="155" r="5" /><circle cx="345" cy="155" r="5" />
      </g>
      <g fill="currentColor" opacity=".55">
        <circle cx="177" cy="45" r="2" /><circle cx="345" cy="45" r="2" />
        <circle cx="177" cy="155" r="2" /><circle cx="345" cy="155" r="2" />
      </g>
      <circle cx="330" cy="155" r="4" fill="var(--art-highlight, var(--orange))" />
      <text x="72" y="55" fill="currentColor" font-size="12" font-family="var(--mono, monospace)" opacity=".75">02 / BUILD</text>
      <text x="384" y="158" fill="currentColor" font-size="12" font-family="var(--mono, monospace)" opacity=".75">v0.1</text>
    </>}
  </svg>
</div>
