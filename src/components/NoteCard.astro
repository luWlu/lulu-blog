---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url, dateLabel, readingTime } from '../lib/site';
interface Props { note: CollectionEntry<'notes'>; index?: number; }
const { note, index = 0 } = Astro.props;
---
<a href={url(`notes/${note.id}/`)} class="note-card" data-note data-category={note.data.category} data-tags={JSON.stringify(note.data.tags)} data-title={note.data.title}>
  <div class="note-card-top"><span class:list={['category-pill', `category-color-${index % 3}`]}>{note.data.category}</span>{note.data.sample && <span class="sample-label">示例内容</span>}<Icon name="arrow" size={19} class="card-arrow" /></div>
  <h3>{note.data.title}</h3>
  <p>{note.data.description}</p>
  <div class="note-card-bottom"><time datetime={note.data.date.toISOString()}>{dateLabel(note.data.date)}</time><span><Icon name="clock" size={13} /> {readingTime(note.body)} 分钟阅读</span></div>
</a>